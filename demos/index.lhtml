<?lua
    -- The nav partial and the shared utils module showcase include() and require()
    local utils = require("utils")

    log.info("Index page rendered")

    local today = os.date("*t")
    local last_day = os.date("*t", os.time({
        year = today.year,
        month = today.month + 1,
        day = 0
    })).day
    local num_days = last_day - today.day + 1
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Red Crescent</title>
    <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
    <?lua include("partials/nav.lhtml") ?>
    <main>
        <h1>Welcome to Red Crescent<?lua= request.query.name and (", " .. html_escape(request.query.name)) or "" ?>!</h1>
        <p>A PHP-like web server rendering <code>.lhtml</code> templates with Lua. This page uses
        <code>include()</code> for the nav bar, <code>require()</code> for a shared Lua module,
        and inline <code>&lt;?lua= ... ?&gt;</code> expressions.</p>

        <h2>The current time is <?lua= os.date("%H:%M:%S") ?></h2>

        <h2>Remaining days of this month</h2>
        <ul>
            <?lua for day = today.day, last_day do ?>
                <li><?lua= os.date("%A, %d %B %Y", os.time({year = today.year, month = today.month, day = day})) ?></li>
            <?lua end ?>
        </ul>

        <h2>Some numbers about the remaining month</h2>
        <p>Total days remaining: <?lua= num_days ?></p>
        <p>Weeks remaining (including this one): <?lua= math.ceil(num_days / 7) ?></p>
        <p>Approximate hours of work remaining (8 hour work days, courtesy of <code>utils.lua</code>):
            <?lua= utils.remaining_work_hours(today, last_day) ?>
        </p>
    </main>
</body>
</html>
