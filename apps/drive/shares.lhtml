<?lua
    local dbm = require("lib.db")
    local auth = require("lib.auth")
    local filesm = require("lib.files")
    local sharesm = require("lib.shares")
    local util = require("lib.util")

    local db = dbm.open()
    local user = auth.require_login(db)

    -- No target means the overview: every link this user has handed out.
    local has_target = (request.query.file and request.query.file ~= "")
        or (request.query.folder and request.query.folder ~= "")

    local kind, target, shares
    if has_target then
        if request.query.folder and request.query.folder ~= "" then
            kind, target = "folder", filesm.get_folder(db, user, request.query.folder)
        else
            kind, target = "file", filesm.get_file(db, user, request.query.file)
        end
        if not target then
            redirect("/?err=" .. util.urlencode("That item no longer exists."))
        end
        shares = sharesm.for_target(db, user, kind, target)
    else
        shares = sharesm.all_for_user(db, user)
    end

    local base = util.base_url()
    local now = os.time()

    page_title = target and ("Share " .. target.name) or "Shared links"
    current_user = user
    csrf_html = auth.csrf_field(user)
?>
<?lua include("partials/header.lhtml") ?>

<?lua== util.flash_html() ?>

<?lua if not has_target then ?>

<h1>🔗 Shared links</h1>
<p class="meta">Every link you have handed out. Revoking one stops it working immediately.
    · <a href="/">back to files</a></p>

<?lua if #shares == 0 then ?>
    <p class="meta">You have not shared anything yet. Use <strong>Share</strong> next to any
    file or folder to create a link.</p>
<?lua else ?>
<table class="listing">
    <tr><th>Shared item</th><th>Link</th><th>Created</th><th>Expires</th><th>Downloads</th><th class="actions">Actions</th></tr>
    <?lua for _, share in ipairs(shares) do ?>
        <?lua
            local is_folder = share.folder_id ~= nil
            local expired = share.expires_at and share.expires_at <= now
            local target_url = is_folder
                and ("/?folder=" .. share.folder_id)
                or ("/download.lhtml?id=" .. share.file_id)
            local link = base .. "/s/" .. util.urlencode(share.token)
        ?>
        <tr>
            <td><?lua= is_folder and "📁" or "📄" ?>
                <a href="<?lua= target_url ?>"><?lua= share.target_name or "(gone)" ?></a>
                <?lua if share.file_size then ?><span class="meta">(<?lua= util.human_size(share.file_size) ?>)</span><?lua end ?>
            </td>
            <td><a class="sharetoken" href="<?lua= link ?>" title="<?lua= link ?>"><?lua= share.token ?></a></td>
            <td class="meta"><?lua= util.format_time(share.created_at) ?></td>
            <td class="meta"><?lua
                if not share.expires_at then ?>never<?lua
                elseif expired then ?><strong>expired</strong><?lua
                else ?><?lua= util.format_time(share.expires_at) ?><?lua end ?></td>
            <td class="meta"><?lua= share.downloads ?></td>
            <td class="actions">
                <a href="/shares.lhtml?<?lua= is_folder and "folder" or "file" ?>=<?lua= is_folder and share.folder_id or share.file_id ?>"
                   title="Manage links" aria-label="Manage links">🔗</a>
                <form class="inline" method="post" action="/actions.lhtml"
                      data-confirm="Revoke this link? Anyone holding it loses access.">
                    <?lua== csrf_html ?>
                    <input type="hidden" name="action" value="share_revoke">
                    <input type="hidden" name="from" value="all">
                    <input type="hidden" name="token" value="<?lua= share.token ?>">
                    <button class="danger-icon" type="submit"
                            title="Revoke" aria-label="Revoke">🗑</button>
                </form>
            </td>
        </tr>
    <?lua end ?>
</table>
<?lua end ?>

<?lua else ?>

<h1><?lua= kind == "folder" and "📁" or "📄" ?> Share links for <?lua= target.name ?></h1>
<p class="meta">
    <?lua if kind == "folder" then ?>
        Anyone with a link can browse this folder and download what is inside it.
        · <a href="/?folder=<?lua= target.id ?>">open folder</a>
    <?lua else ?>
        <?lua= util.human_size(target.size) ?>
        · <a href="/download.lhtml?id=<?lua= target.id ?>">download</a>
    <?lua end ?>
    · <a href="/">back to files</a>
</p>

<div class="panel">
    <h2>Create a new link</h2>
    <form class="rowform" method="post" action="/actions.lhtml">
        <?lua== csrf_html ?>
        <input type="hidden" name="action" value="share_create">
        <input type="hidden" name="kind" value="<?lua= kind ?>">
        <input type="hidden" name="id" value="<?lua= target.id ?>">
        <select name="expires">
            <option value="">Never expires</option>
            <option value="3600">1 hour</option>
            <option value="86400">24 hours</option>
            <option value="604800">7 days</option>
        </select>
        <button type="submit">Create link</button>
    </form>
</div>

<?lua if #shares == 0 then ?>
    <p class="meta">No share links yet.</p>
<?lua else ?>
    <?lua for _, share in ipairs(shares) do ?>
        <div class="panel">
            <span class="sharelink"><?lua= base ?>/s/<?lua= util.urlencode(share.token) ?></span>
            <p class="meta">
                created <?lua= util.format_time(share.created_at) ?>
                · <?lua= share.downloads ?> download<?lua= share.downloads == 1 and "" or "s" ?>
                · <?lua if share.expires_at then ?>expires <?lua= util.format_time(share.expires_at) ?><?lua else ?>never expires<?lua end ?>
            </p>
            <form class="inline" method="post" action="/actions.lhtml">
                <?lua== csrf_html ?>
                <input type="hidden" name="action" value="share_revoke">
                <input type="hidden" name="kind" value="<?lua= kind ?>">
                <input type="hidden" name="id" value="<?lua= target.id ?>">
                <input type="hidden" name="token" value="<?lua= share.token ?>">
                <button class="danger" type="submit">Revoke</button>
            </form>
        </div>
    <?lua end ?>
<?lua end ?>

<?lua end ?>

<?lua include("partials/footer.lhtml") ?>
